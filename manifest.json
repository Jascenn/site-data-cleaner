{
  "manifest_version": 3,
  "name": "Site Data Cleaner",
  "version": "1.2.0",
  "description": "One-click clear cookies & site data, then reload. Silent list for auto-clear on reload.",
  "permissions": [
    "cookies",
    "scripting",
    "activeTab",
    "browsingData",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Clear current site's data and reload",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "clear-current-site": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Clear current site data and reload"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
